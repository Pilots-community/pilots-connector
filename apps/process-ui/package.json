{
  "name": "@pilots/process-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The demo process management UI: a BFF that holds one API key and owns its own users, plus the SPA it serves.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm build:web && tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@pilots/client": "workspace:*",
    "@pilots/protocol": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "1.7.2",
    "fastify": "5.11.3",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}
