# Configuration for the connector. Copy to .env and edit.
#
# NOTHING IN THIS FILE IS A SECRET, and nothing here should ever become one.
# The signing key, the API-key pepper and the admin token are *generated on first
# boot* and written to the secret store — so no human, repository or pipeline
# variable ever handles a private key. Secret NAMES are fine to commit; secret
# VALUES are not.

PILOTS_PORT=3000
PILOTS_HOST=0.0.0.0
PILOTS_LOG_LEVEL=info

# memory | file. `file` is the small-party profile: one mounted volume, no
# database container.
PILOTS_STORE=file
PILOTS_STORE_DIR=./data

# Where the generated secrets live. Must be outside the repository.
# PILOTS_SECRETS_FILE=./data/secrets.json

PILOTS_DEFINITIONS_DIR=../../docs/definitions

# One participant, the short form.
PILOTS_PARTICIPANT_ID=acme
PILOTS_PARTICIPANT_DID=did:web:acme-shipping.example
PILOTS_PARTICIPANT_NAME=Acme Shipping
PILOTS_BASE_URL=http://localhost:3000

# Several participants on one connector — the hosted topology. Overrides the
# four variables above.
# PILOTS_PARTICIPANTS=[{"id":"acme","did":"did:web:acme-shipping.example","displayName":"Acme Shipping","baseUrl":"http://localhost:3000"}]

# Audit reads as well as mutations and denials. Off by default, or the log
# drowns in GETs.
# PILOTS_AUDIT_READS=false

# For a deployment backed by a real secret manager, secrets are injected instead
# of generated. These are variable NAMES; never commit their values.
# PILOTS_SIGNING_KEYS=
# PILOTS_API_KEY_PEPPER=
# PILOTS_ADMIN_TOKEN_HASH=
