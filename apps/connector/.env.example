# Configuration for the connector. Copy to .env and edit.
#
# NOTHING IN THIS FILE IS A SECRET, and nothing here should ever become one.
# The signing key, the API-key pepper and the admin token are *generated on first
# boot* and written to the secret store — so no human, repository or pipeline
# variable ever handles a private key. Secret NAMES are fine to commit; secret
# VALUES are not.

PILOTS_PORT=3000
PILOTS_HOST=0.0.0.0
PILOTS_LOG_LEVEL=info

# memory | file. `file` is the small-party profile: one mounted volume, no
# database container.
PILOTS_STORE=file
PILOTS_STORE_DIR=./data

# Where the generated secrets live. Must be outside the repository.
# PILOTS_SECRETS_FILE=./data/secrets.json

PILOTS_DEFINITIONS_DIR=../../docs/definitions

# One participant, the short form.
PILOTS_PARTICIPANT_ID=acme
PILOTS_PARTICIPANT_DID=did:web:acme-shipping.example
PILOTS_PARTICIPANT_NAME=Acme Shipping
PILOTS_BASE_URL=http://localhost:3000

# Several participants on one connector — the hosted topology. Overrides the
# four variables above.
# PILOTS_PARTICIPANTS=[{"id":"acme","did":"did:web:acme-shipping.example","displayName":"Acme Shipping","baseUrl":"http://localhost:3000"}]

# Audit reads as well as mutations and denials. Off by default, or the log
# drowns in GETs.
# PILOTS_AUDIT_READS=false

# For a deployment backed by a real secret manager, secrets are injected instead
# of generated. These are variable NAMES; never commit their values.
# PILOTS_SIGNING_KEYS=
# PILOTS_API_KEY_PEPPER=
# PILOTS_ADMIN_TOKEN_HASH=

# ── peers ──────────────────────────────────────────────────────────────────
# `http` (default) or `none`. `none` disables outbound peer calls entirely, which
# is the right setting for a connector with no counterparties.
# PILOTS_PEER_TRANSPORT=http

# How often the delivery scan loops run, in milliseconds. `0` disables them, and
# tests drive the pumps by hand instead. Retries are compared against `Clock`,
# never scheduled with setTimeout, so nothing is lost on restart.
# PILOTS_DELIVERY_INTERVAL_MS=1000

# Connections established at boot instead of by handshake. A demo shortcut: the
# handshake still works without it, and S0 in the test suite proves that.
# PILOTS_CONNECTIONS=[{"participantId":"acme","peerDid":"did:web:vanmoer.example","peerBaseUrl":"http://vanmoer:3000","inbound":{"channel":"stream"},"outbound":{"channel":"stream"}}]

# Peers whose connection requests are accepted without asking the operator. The
# trust checks still run; this decides who you skip the prompt for.
# PILOTS_AUTO_ACCEPT=did:web:vanmoer.example

# DEVELOPMENT ONLY, and the connector refuses to start with it under
# NODE_ENV=production. Resolves a peer's DID through the base URL configured for
# it rather than through the URL the DID implies, which reduces the
# domain-binding check to "an operator wrote this address down". It exists
# because the demo's DIDs are on the reserved .example TLD and resolve nowhere.
# PILOTS_DEV_DID_DIRECTORY=false

# ── the large-party profile ────────────────────────────────────────────────
# PILOTS_STORE=mongo needs a replica set: the store port promises that appending
# an event and updating the instance is one atomic operation, and a standalone
# mongod has no multi-document transactions. The adapter refuses rather than
# silently breaking the promise.
#
# The URI is a secret in every deployment that matters, so it has no default and
# nothing here is a value. Inject it.
# PILOTS_STORE=mongo
# PILOTS_MONGO_URI=
# PILOTS_MONGO_DB=pilots

# The largest attachment this connector accepts. A ceiling, not a target: it also
# bounds the HTTP body limit, and the Mongo adapter stores attachment bytes
# inline, so raising this past ~15 MB means moving that adapter to GridFS.
# PILOTS_MAX_ATTACHMENT_BYTES=8388608
