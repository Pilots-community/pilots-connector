{
  "name": "@pilots/connector",
  "version": "0.1.0",
  "description": "The connector: three API surfaces, the store, and a minimal admin UI.",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm build:ui && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin-ui/tsconfig.json",
    "test": "vitest run",
    "build:ui": "vite build --config src/admin-ui/vite.config.mts src/admin-ui",
    "dev:ui": "vite --config src/admin-ui/vite.config.mts src/admin-ui"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@pilots/protocol": "workspace:^",
    "fastify": "5.11.3",
    "mongodb": "^7.6.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "11.2.3",
    "@pilots/client": "workspace:*",
    "@swc/core": "1.16.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "unplugin-swc": "1.5.11",
    "vite": "8.2.2"
  }
}
