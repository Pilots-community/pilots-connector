{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git clean:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -m:*)",
      "Bash(git remote:*)",
      "Bash(git init:*)",
      "Bash(git config:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git filter-branch:*)",
      "Bash(gh:*)",
      "Bash(sudo:*)",
      "Edit(./REFINEMENT.md)",
      "Write(./REFINEMENT.md)",
      "Edit(REFINEMENT.md)",
      "Write(REFINEMENT.md)"
    ],
    "allow": [
      "Bash(./scripts/n:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git ls-files:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(sqlite3:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(lsof:*)",
      "Bash(kill:*)",
      "Bash(pkill -f:*)",
      "Bash(which:*)",
      "Bash(printf:*)",
      "Bash(echo:*)",
      "Bash(diff:*)",
      "Bash(sed -n:*)",
      "Bash(shellcheck:*)",
      "Bash(htpasswd:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -i http://localhost:*)",
      "Bash(curl -v http://localhost:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Edit(./**)",
      "Write(./**)",
      "Read(./**)",
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__preview_stop",
      "mcp__Claude_Browser__preview_list",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__computer",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__form_input",
      "mcp__Claude_Browser__resize_window",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__tabs_create",
      "mcp__Claude_Browser__tabs_select",
      "mcp__Claude_Browser__tabs_close"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.cmd\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [],
    "PreToolUse": []
  }
}
