{
  "@context": "https://pilots.example/process/v1",
  "id": "container-transport-with-terminal",
  "version": "1.0.0",
  "kind": "service",
  "title": "Container road transport with terminal release",
  "description": "The two-party transport process with a third participant. Exists to prove that adding a role is a definition change and not a redesign: compare with container-transport.json — same schema, one more role, three more transitions. Not executed in the first milestone.",

  "roles": [
    { "id": "shipper", "title": "Shipper", "cardinality": 1, "protocolRole": "requester" },
    { "id": "transporter", "title": "Transporter", "cardinality": 1, "protocolRole": "provider" },
    { "id": "terminal", "title": "Terminal operator", "cardinality": 1, "protocolRole": "provider" }
  ],
  "hostedBy": "transporter",

  "initialState": "PENDING_CONTRACT",
  "states": [
    { "id": "PENDING_CONTRACT", "title": "Awaiting an agreed quotation" },
    { "id": "CONTRACTED", "title": "Contracted" },
    { "id": "ASSIGNED", "title": "Assigned" },
    { "id": "GATE_BOOKED", "title": "Gate slot booked" },
    { "id": "RELEASED", "title": "Released by terminal" },
    { "id": "PICKED_UP", "title": "Picked up" },
    { "id": "DELIVERED", "title": "Delivered" },
    { "id": "CANCELLED", "title": "Cancelled" }
  ],
  "terminalStates": ["DELIVERED", "CANCELLED"],

  "defaultVisibility": "all",

  "data": {
    "type": "object",
    "required": ["containerType", "terminal"],
    "properties": {
      "containerNumber": { "type": "string", "pattern": "^[A-Z]{4}[0-9]{7}$" },
      "containerType": { "type": "string", "enum": ["20DV", "40DV", "40HC", "45HC"] },
      "terminal": { "type": "string" },
      "pickup": { "type": "object" },
      "dropoff": { "type": "object" },
      "price": { "type": "object" },
      "vehiclePlate": { "type": "string" },
      "driverName": { "type": "string" },
      "driverPhone": { "type": "string" },
      "plannedPickupAt": { "type": "string", "format": "date-time" },
      "gateSlot": {
        "type": "object",
        "properties": {
          "from": { "type": "string", "format": "date-time" },
          "to": { "type": "string", "format": "date-time" },
          "reference": { "type": "string" }
        }
      },
      "releaseReference": { "type": "string" },
      "actualPickupAt": { "type": "string", "format": "date-time" },
      "deliveredAt": { "type": "string", "format": "date-time" },
      "proofOfDelivery": {
        "type": "object",
        "properties": { "sha256": { "type": "string" } }
      },
      "cancellationReason": { "type": "string" }
    }
  },

  "transitions": [
    {
      "id": "startExecution",
      "title": "Quotation agreed — start execution",
      "from": ["PENDING_CONTRACT"],
      "to": "CONTRACTED",
      "by": []
    },
    {
      "id": "assign",
      "title": "Assign vehicle and driver",
      "from": ["CONTRACTED"],
      "to": "ASSIGNED",
      "by": ["transporter"],
      "patch": {
        "type": "object",
        "required": ["vehiclePlate", "plannedPickupAt"],
        "properties": {
          "vehiclePlate": { "type": "string" },
          "driverName": { "type": "string" },
          "driverPhone": { "type": "string" },
          "plannedPickupAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "id": "bookGate",
      "title": "Book a gate slot",
      "from": ["ASSIGNED"],
      "to": "GATE_BOOKED",
      "by": ["transporter"],
      "deadline": "PT12H",
      "onDeadline": "cancel",
      "patch": {
        "type": "object",
        "required": ["gateSlot"],
        "properties": {
          "gateSlot": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "format": "date-time" },
              "to": { "type": "string", "format": "date-time" },
              "reference": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "id": "confirmRelease",
      "title": "Confirm release",
      "from": ["GATE_BOOKED"],
      "to": "RELEASED",
      "by": ["terminal"],
      "patch": {
        "type": "object",
        "required": ["releaseReference"],
        "properties": { "releaseReference": { "type": "string" } }
      }
    },
    {
      "id": "pickup",
      "title": "Confirm pickup",
      "from": ["RELEASED"],
      "to": "PICKED_UP",
      "by": ["transporter", "terminal"],
      "patch": {
        "type": "object",
        "required": ["actualPickupAt"],
        "properties": {
          "actualPickupAt": { "type": "string", "format": "date-time" },
          "containerNumber": { "type": "string", "pattern": "^[A-Z]{4}[0-9]{7}$" }
        }
      }
    },
    {
      "id": "deliver",
      "title": "Confirm delivery",
      "from": ["PICKED_UP"],
      "to": "DELIVERED",
      "by": ["transporter"],
      "attachments": { "required": true, "mime": ["application/pdf", "image/jpeg"] },
      "patch": {
        "type": "object",
        "required": ["deliveredAt", "proofOfDelivery"],
        "properties": {
          "deliveredAt": { "type": "string", "format": "date-time" },
          "proofOfDelivery": {
            "type": "object",
            "required": ["sha256"],
            "properties": { "sha256": { "type": "string" } }
          }
        }
      }
    },
    {
      "id": "cancel",
      "title": "Cancel",
      "from": ["*"],
      "to": "CANCELLED",
      "by": ["shipper", "transporter"],
      "patch": {
        "type": "object",
        "properties": { "cancellationReason": { "type": "string" } }
      }
    }
  ],

  "visibility": [
    { "path": "price", "roles": ["shipper", "transporter"] },
    { "path": "dropoff", "roles": ["shipper", "transporter"] },
    { "path": "driverName", "roles": ["transporter", "terminal"] },
    { "path": "driverPhone", "roles": ["transporter"] },
    { "path": "driverName", "roles": ["shipper"], "whenState": ["PICKED_UP", "DELIVERED"] }
  ],

  "links": [
    { "onEvent": "quotation:AGREED", "triggers": "startExecution" },
    { "onEvent": "quotation:REJECTED", "triggers": "cancel" },
    { "onEvent": "quotation:WITHDRAWN", "triggers": "cancel" },
    { "onEvent": "quotation:EXPIRED", "triggers": "cancel" }
  ]
}
