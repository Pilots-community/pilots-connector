{
  "@context": "https://pilots.example/process/v1",
  "id": "container-weighing-quotation",
  "version": "1.0.0",
  "kind": "quotation",
  "title": "Container weighing — standing quotation",
  "description": "A fixed-price offering. No negotiation: the instance is created and immediately agreed. Withdrawal remains possible while the service has not started.",
  "roles": [
    {
      "id": "shipper",
      "title": "Shipper",
      "cardinality": 1,
      "protocolRole": "requester"
    },
    {
      "id": "weigher",
      "title": "Weighing company",
      "cardinality": 1,
      "protocolRole": "provider"
    }
  ],
  "hostedBy": "weigher",
  "initialState": "DRAFT",
  "states": [
    {
      "id": "DRAFT",
      "title": "Draft"
    },
    {
      "id": "AGREED",
      "title": "Agreed",
      "outcome": "fulfilled"
    },
    {
      "id": "WITHDRAWN",
      "title": "Withdrawn",
      "outcome": "abandoned"
    }
  ],
  "defaultVisibility": "all",
  "data": {
    "type": "object",
    "required": ["offering", "price", "conditions"],
    "properties": {
      "offering": {
        "type": "string",
        "format": "uri"
      },
      "price": {
        "type": "object",
        "required": ["value", "currency"],
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      },
      "conditions": {
        "type": "object",
        "properties": {
          "terminal": {
            "type": "string"
          },
          "containerType": {
            "type": "string",
            "enum": ["20DV", "40DV", "40HC", "45HC"]
          }
        }
      },
      "validUntil": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "transitions": [
    {
      "id": "agree",
      "title": "Accept the standing price",
      "from": ["DRAFT"],
      "to": "AGREED",
      "by": [],
      "auto": true,
      "guards": [
        {
          "required": ["price", "offering"]
        }
      ]
    },
    {
      "id": "withdraw",
      "title": "Withdraw",
      "from": ["*"],
      "to": "WITHDRAWN",
      "by": ["shipper", "weigher"],
      "patch": {
        "type": "object",
        "properties": {
          "withdrawalReason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "visibility": [],
  "links": []
}
