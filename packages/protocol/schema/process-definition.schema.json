{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilots.example/schema/v1/process-definition.schema.json",
  "title": "Process definition",
  "description": "The shared artefact: roles, states, transitions, data schema, visibility, links.",
  "type": "object",
  "properties": {
    "@context": {
      "default": "https://pilots.example/process/v1",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "service",
        "quotation"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "roles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "cardinality": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "protocolRole": {
            "type": "string",
            "enum": [
              "requester",
              "provider",
              "observer"
            ]
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "hostedBy": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "initialState": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "createdBy": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "states": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "terminalStates": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "defaultVisibility": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "none"
      ]
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "transitions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "from": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "*"
                },
                {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                }
              ]
            }
          },
          "to": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "by": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "patch": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "guards": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "attachments": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "mime": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "maxSize": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "required"
            ],
            "additionalProperties": false
          },
          "deadline": {
            "type": "string"
          },
          "onDeadline": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "auto": {
            "default": false,
            "type": "boolean"
          },
          "requiresCredential": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "from",
          "by"
        ],
        "additionalProperties": false
      }
    },
    "visibility": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "roles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "whenState": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          }
        },
        "required": [
          "path",
          "roles"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "onEvent": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*:[A-Za-z][A-Za-z0-9_-]*$"
          },
          "triggers": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "required": [
          "onEvent",
          "triggers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "kind",
    "title",
    "roles",
    "hostedBy",
    "initialState",
    "states",
    "terminalStates",
    "data",
    "transitions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
