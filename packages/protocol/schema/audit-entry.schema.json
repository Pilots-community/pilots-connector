{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilots.example/schema/v1/audit-entry.schema.json",
  "title": "Audit entry",
  "description": "Locally hash-chained, never replicated. Records what was refused.",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "participantId": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "admin",
        "local",
        "peer",
        "runtime"
      ]
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "adminSession",
            "apiKey",
            "peer",
            "runtime"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actorRef": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "instance": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "connection": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "apiKey": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "subscription": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "offering": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "definition": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "denied",
        "failed"
      ]
    },
    "problem": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "request": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "maxLength": 16
            },
            "path": {
              "type": "string",
              "maxLength": 1024
            },
            "ip": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "jti": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 255
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "method",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "prev": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "seq",
    "at",
    "participantId",
    "category",
    "action",
    "actor",
    "subject",
    "outcome",
    "prev"
  ],
  "additionalProperties": false
}
