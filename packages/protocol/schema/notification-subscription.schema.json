{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilots.example/schema/v1/notification-subscription.schema.json",
  "title": "Notification subscription",
  "description": "Local delivery configuration: how a party with no UI is told it is their turn.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "participantId": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "channel": {
      "type": "string",
      "enum": [
        "webhook",
        "sse"
      ]
    },
    "target": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "headers": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "secretRef": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 255
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "notify": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "action.required",
          "action.cleared",
          "state.changed",
          "event"
        ]
      }
    },
    "filter": {
      "default": {},
      "type": "object",
      "properties": {
        "definitions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          }
        },
        "kinds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "service",
              "quotation"
            ]
          }
        },
        "states": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "transitions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "instances": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PAUSED",
        "DEGRADED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "participantId",
    "label",
    "channel",
    "notify",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
