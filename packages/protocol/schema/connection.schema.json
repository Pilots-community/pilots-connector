{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilots.example/schema/v1/connection.schema.json",
  "title": "Connection",
  "description": "A verified, persistent, bidirectional relationship between two participants.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "participantId": {
      "type": "string",
      "minLength": 1
    },
    "peerDid": {
      "type": "string",
      "pattern": "^did:web:[a-z0-9]([a-z0-9._%-]*[a-z0-9])?(:[A-Za-z0-9._%-]+)*$"
    },
    "peerBaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "peerDisplayName": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING_INBOUND",
        "PENDING_OUTBOUND",
        "ACTIVE",
        "DEGRADED",
        "REJECTED",
        "REVOKED"
      ]
    },
    "outbound": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "const": "webhook"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "channel",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "const": "stream"
            }
          },
          "required": [
            "channel"
          ],
          "additionalProperties": false
        }
      ]
    },
    "inbound": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "const": "webhook"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "channel",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "const": "stream"
            }
          },
          "required": [
            "channel"
          ],
          "additionalProperties": false
        }
      ]
    },
    "lastError": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "participantId",
    "peerDid",
    "peerBaseUrl",
    "status",
    "outbound",
    "inbound",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
